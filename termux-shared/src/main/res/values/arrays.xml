<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Light terminal color scheme: the built-in colors used in light mode when no custom
      colors.properties exists (i.e. the "Default" entry of the color-scheme picker).

      These live in termux-shared, not in the app module, because the scheme picker itself lives
      here: it has to resolve the "Default" row's preview (background / foreground / 16-color
      palette) from the very same source that the terminal is later themed with. Keeping a second
      copy in the app would let the preview and the terminal drift apart.

      Order matters: color0..color15 are read positionally against the keys array.
    -->
    <string-array name="light_terminal_color_scheme_keys">
        <item>background</item>
        <item>foreground</item>
        <item>color0</item>
        <item>color1</item>
        <item>color2</item>
        <item>color3</item>
        <item>color4</item>
        <item>color5</item>
        <item>color6</item>
        <item>color7</item>
        <item>color8</item>
        <item>color9</item>
        <item>color10</item>
        <item>color11</item>
        <item>color12</item>
        <item>color13</item>
        <item>color14</item>
        <item>color15</item>
    </string-array>

    <string-array name="light_terminal_color_scheme_values">
        <item>#ffffff</item>
        <item>#000000</item>
        <item>#000000</item>
        <item>#cd0000</item>
        <item>#00cd00</item>
        <item>#cdcd00</item>
        <item>#1060c0</item>
        <item>#cd00cd</item>
        <item>#00cdcd</item>
        <item>#404040</item>
        <item>#808080</item>
        <item>#ff0000</item>
        <item>#00ff00</item>
        <item>#ffff00</item>
        <item>#6969ff</item>
        <item>#ff00ff</item>
        <item>#00ffff</item>
        <item>#ffffff</item>
    </string-array>
</resources>
