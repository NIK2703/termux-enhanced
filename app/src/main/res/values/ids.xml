<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tag holding the TerminalSession bound to a tab view, used to locate the
         view when animating a tab close. -->
    <item name="session_tab_session_tag" type="id" />
    <!-- Tag marking a tab view that is currently playing its close animation. -->
    <item name="session_tab_closing_tag" type="id" />
    <!-- Tag marking a tab view whose session finished with a non-zero exit status (error). -->
    <item name="session_tab_error_tag" type="id" />
    <!-- Cached per-tab render state (TabRenderState): makes a title-only refresh a pure
         diff — no attribute is re-applied unless it actually changed. -->
    <item name="session_tab_render_state_tag" type="id" />
    <!-- The TextWatcher currently installed on a slider's value label (UnitSeekBarPreference).
         Kept as a tag because that label view is recycled across preference rows, so a new bind has
         to detach the previous watcher before installing its own. -->
    <item name="seekbar_value_watcher_tag" type="id" />
</resources>
