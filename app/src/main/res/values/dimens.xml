<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tab dimensions -->
    <dimen name="terminal_tab_height_double">36dp</dimen>
    <dimen name="terminal_tab_height_single">24dp</dimen>
    <dimen name="terminal_tab_corner_radius">18dp</dimen>
    <dimen name="terminal_tab_padding_start_single">8dp</dimen>
    <dimen name="terminal_tab_padding_start_double">12dp</dimen>
    <!-- Title cap and the gap between the title and the close (x) button. When the
         title is truncated we reclaim this gap and add it to the title max width, so
         the tab's total width is unchanged but more of the clipped label shows. -->
    <dimen name="terminal_tab_title_max_width">100dp</dimen>
    <dimen name="terminal_tab_close_gap">4dp</dimen>

    <!-- Text input panel (matches vertical scrollbar thumb) -->
    <dimen name="terminal_text_input_corner_radius">11dp</dimen>
    <dimen name="terminal_text_input_stroke">0.5dp</dimen>

    <!-- Auto-complete suggestions popup (message-history) -->
    <dimen name="autocomplete_popup_corner_radius">6dp</dimen>
    <dimen name="autocomplete_popup_elevation">8dp</dimen>
    <dimen name="autocomplete_popup_item_padding_horizontal">7dp</dimen>
    <dimen name="autocomplete_popup_item_padding_vertical">5dp</dimen>
    <dimen name="autocomplete_popup_min_width">200dp</dimen>
    <dimen name="autocomplete_popup_width_margin">16dp</dimen>
    <item name="autocomplete_popup_width_fraction" type="fraction">70%</item>
    <dimen name="autocomplete_popup_x_offset">4dp</dimen>
    <dimen name="autocomplete_popup_edge_margin">8dp</dimen>
    <dimen name="autocomplete_popup_y_offset">4dp</dimen>
    <dimen name="autocomplete_popup_min_y">16dp</dimen>
    <item name="autocomplete_popup_content_alpha" type="fraction">90%</item>
    <item name="autocomplete_popup_shadow_alpha" type="fraction">65%</item>

    <!-- Message history popup dimensions -->
    <dimen name="message_history_popup_max_height">520dp</dimen>
    <dimen name="message_history_popup_gap">24dp</dimen>

    <!-- Width of the value label on a settings slider row (preference_seekbar_settings.xml).

         Without this the label is wrap_content on top of the library's 36dp
         preference_seekbar_value_minWidth, so a label that does not fit (any value carrying a
         unit: "0.1 dp", "20 dp", "200%") widens its own row and squeezes that row's SeekBar -
         every slider then ends its track at a different x.

         Pinned here so every slider reserves the same label box and therefore draws the same
         track length. Sized from real font metrics, not guessed: the widest label any slider can
         produce is "0.1 dp" (the extra-keys button margin slider at its minimum of 1, divided by
         10), which measures 44.9dp in the system font at the 16sp of
         ?android:attr/textAppearanceListItem, plus the label's 8dp start padding = 52.9dp. 60dp
         leaves ~7dp of slack, which also absorbs a device whose default font is wider than
         Roboto. The other worst cases, for reference: "20 dp"/"24 dp" 40.7dp, "16 sp" 39.9dp,
         "40 px"/"90 px" 39.5dp, "200%" 39.5dp. -->
    <dimen name="preference_seekbar_value_width">60dp</dimen>
</resources>
