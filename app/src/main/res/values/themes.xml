<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
     https://material.io/develop/android/theming/dark
    -->

    <!-- TermuxApp DayNight DarkActionBar theme. -->
    <style name="Theme.TermuxApp.DayNight.DarkActionBar" parent="Theme.BaseActivity.DayNight.DarkActionBar"/>
    <!-- TermuxApp DayNight NoActionBar theme. -->
    <style name="Theme.TermuxApp.DayNight.NoActionBar" parent="Theme.BaseActivity.DayNight.NoActionBar"/>

    <!-- Settings screen theme: section (category) subtitles use the same slightly-different
         background as the header so they do not blend into the content. -->
    <style name="Theme.TermuxApp.Settings" parent="Theme.TermuxApp.DayNight.NoActionBar">
        <item name="preferenceCategoryStyle">@style/Preference.Category.Settings</item>
        <!-- Every preference row is redirected to a layout whose title wraps instead of being cut
             off with a trailing "…"; see @layout/preference_settings /
             @layout/preference_seekbar_settings and the Preference.*.Settings styles below.
             Each row type resolves its own style attribute (preferenceStyle for a plain <Preference>,
             switchPreferenceCompatStyle for <SwitchPreferenceCompat>, ...), so every one of them has
             to be listed here - redirecting only the slider is not enough. -->
        <item name="preferenceStyle">@style/Preference.Settings</item>
        <item name="switchPreferenceStyle">@style/Preference.SwitchPreference.Settings</item>
        <item name="switchPreferenceCompatStyle">@style/Preference.SwitchPreferenceCompat.Settings</item>
        <item name="checkBoxPreferenceStyle">@style/Preference.CheckBoxPreference.Settings</item>
        <item name="dialogPreferenceStyle">@style/Preference.DialogPreference.Settings</item>
        <item name="editTextPreferenceStyle">@style/Preference.DialogPreference.EditTextPreference.Settings</item>
        <item name="preferenceScreenStyle">@style/Preference.PreferenceScreen.Settings</item>
        <item name="seekBarPreferenceStyle">@style/Preference.SeekBarPreference.Settings</item>
        <!-- Inactive (disabled) preferences show grey text instead of pure black:
             @color/preference_text_primary grays the title out via its disabled state. -->
        <item name="android:textColorPrimary">@color/preference_text_primary</item>
        <!-- Status bar is transparent (see SettingsActivity) so the header colour shows through;
             keep its icons/text dark (black) on the light header background. -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Preference.Category.Settings" parent="Preference.Category">
        <item name="android:layout">@layout/preference_category_settings</item>
    </style>

    <!--
      Settings preference row styles. Each row type keeps its stock AndroidX material parent (so the
      widget layout, dividers, icon space and seek bar value stay exactly as they are) and only
      swaps the row layout for one whose title wraps.

      Why the layout and not android:singleLineTitle: AndroidX honours singleLineTitle only when the
      attribute is explicitly declared (Preference.onBindViewHolder calls setSingleLine() behind
      mHasSingleLineTitleAttr), and the material styles declare it inconsistently - it is false in
      Preference.Material / SwitchPreference.Material / EditTextPreference.Material but missing from
      SwitchPreferenceCompat.Material, DialogPreference.Material and SeekBarPreference.Material,
      which is exactly why switch and slider rows were the ones still cut off.
    -->
    <style name="Preference.Settings" parent="Preference.Material">
        <item name="android:layout">@layout/preference_settings</item>
    </style>

    <style name="Preference.SwitchPreference.Settings" parent="Preference.SwitchPreference.Material">
        <item name="android:layout">@layout/preference_settings</item>
    </style>

    <style name="Preference.SwitchPreferenceCompat.Settings" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:layout">@layout/preference_settings</item>
    </style>

    <style name="Preference.CheckBoxPreference.Settings" parent="Preference.CheckBoxPreference.Material">
        <item name="android:layout">@layout/preference_settings</item>
    </style>

    <style name="Preference.DialogPreference.Settings" parent="Preference.DialogPreference.Material">
        <item name="android:layout">@layout/preference_settings</item>
    </style>

    <style name="Preference.DialogPreference.EditTextPreference.Settings" parent="Preference.DialogPreference.EditTextPreference.Material">
        <item name="android:layout">@layout/preference_settings</item>
    </style>

    <style name="Preference.PreferenceScreen.Settings" parent="Preference.PreferenceScreen.Material">
        <item name="android:layout">@layout/preference_settings</item>
    </style>

    <!-- Sliders: identical to the AndroidX material seekbar style (adjustable, seek bar value,
         dividers, icon space) except for the layout, where the title is allowed to wrap. -->
    <style name="Preference.SeekBarPreference.Settings" parent="Preference.SeekBarPreference.Material">
        <item name="android:layout">@layout/preference_seekbar_settings</item>
    </style>

    <!-- Fully transparent theme for overlay activities: they host their own dialog/view
         on top of whatever screen is visible underneath (terminal, settings, etc.) and
         must not obscure the content. -->
    <style name="Theme.TermuxApp.Transparent" parent="Theme.TermuxApp.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>

    <!-- Bootstrap selector theme: opaque background so the underlying TermuxActivity
         (status bar, add tab button, input panel toggle) is not visible through it. -->
    <style name="Theme.TermuxApp.BootstrapSelector" parent="Theme.TermuxApp.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>


    <!-- TermuxActivity DayNight NoActionBar theme. -->
    <!-- Light values: used when night mode is disabled, so the activity UI is light. -->
    <style name="Theme.TermuxActivity.DayNight.NoActionBar" parent="Theme.TermuxApp.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryVariant">@color/grey_900</item>

        <item name="android:windowBackground">@color/white</item>

        <!-- Status bar: dark text/icons on light background -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Avoid action mode toolbar pushing down terminal content when
             selecting text on pre-6.0 (non-floating toolbar). -->
        <item name="android:windowActionModeOverlay">true</item>

        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>

        <!-- https://developer.android.com/training/tv/start/start.html#transition-color -->
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>

        <!-- Left drawer. -->
        <item name="buttonBarButtonStyle">@style/TermuxActivity.Drawer.ButtonBarStyle.Light</item>

        <!-- Extra keys colors. -->
        <item name="extraKeysButtonTextColor">@color/black</item>
        <item name="extraKeysButtonActiveTextColor">@color/black</item>
        <item name="extraKeysButtonBackgroundColor">@color/extra_keys_button_background_light</item>
        <item name="extraKeysButtonActiveBackgroundColor">@color/extra_keys_button_active_background_light</item>
    </style>

    <!--
      TermuxActivity theme variant used when the terminal background is transparent and the real
      device wallpaper must show through it.

      android:windowIsTranslucent is what ultimately forces PixelFormat.TRANSLUCENT onto the
      window surface (ViewRootImpl.relayoutWindow() only upgrades the format when
      PFLAG_REQUEST_TRANSPARENT_REGIONS is set, and that flag comes from this theme attribute),
      so it is a *static* theme attribute: switching it requires an activity recreate. The
      companion window flag FLAG_SHOW_WALLPAPER (set at runtime by TermuxActivity) is what
      actually keeps the system wallpaper surface alive below this window.
    -->
    <style name="Theme.TermuxActivity.DayNight.NoActionBar.Wallpaper"
           parent="Theme.TermuxActivity.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- Required: AppCompat themes with windowIsTranslucent can inherit floating behaviour,
             which changes the window layout (wrap_content, insets, dim) and must not happen for
             a full-screen terminal. -->
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!--
      Dialog theme overlay for TermuxActivity dialogs on MIUI/HyperOS.
      The system overlay can force dialog button text to near-black even in
      night mode; override materialAlertDialogButtonStyle with an explicit
      text colour that stays readable on a dark background.
    -->
    <style name="ThemeOverlay.TermuxActivity.Dialog" parent="ThemeOverlay.BaseDialog.DayNight">
        <item name="android:buttonBarButtonStyle">@style/TermuxActivity.Dialog.Button</item>
    </style>

    <style name="TermuxActivity.Dialog.Button" parent="@style/Widget.MaterialComponents.Button.TextButton">
        <!-- Light-mode: black text on the light dialog background. -->
        <item name="android:textColor">@color/black</item>
    </style>



</resources>
