<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Minimal color definitions referenced by the night theme overrides. These
         are standard Material greys so the dark theme resolves without pulling
         extra palette resources. -->
    <color name="grey_100">#f5f5f5</color>
    <color name="bootstrap_selector_background">#FFFFFF</color>
    <color name="grey_200">#eeeeee</color>
    <color name="signal_picker_underlay_fill">#0D000000</color>
    <color name="signal_picker_underlay_stroke">#1A000000</color>

    <!-- Disabled preference text (light theme): neutral grey, clearly set apart from the
         active near-black title so an inactive item reads as disabled. -->
    <color name="preference_text_disabled_light">#767676</color>
    <!-- Dark-theme variant. Also declared here so the resource has a default: it is only ever
         referenced from res/color-night/, but a qualifier-only declaration is a hard lint error
         (MissingDefaultResource) and would crash in any configuration missing the qualifier. -->
    <color name="preference_text_disabled_dark">#A6A6A6</color>
</resources>
