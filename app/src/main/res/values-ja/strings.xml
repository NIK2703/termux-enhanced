    <!-- Terminal font size (Display > Appearance). The same value, the same bounds
         and the same step the pinch gesture uses — see
         TermuxAppSharedPreferences.getFontSize()/changeFontSize(). -->
    <string name="terminal_font_size_title" formatted="false">フォントサイズ</string>

    <!-- ===================== Floating bubble window =====================
         Strings for the bubble (a floating terminal window hosted by SystemUI). The label is only
         shown where the platform can actually bubble, and the button on the service notification
         is now the single manual entry point: there is no context-menu item any more. -->
    <string name="action_open_in_bubble">バブル</string>
    <string name="bubble_notification_channel_description">他のアプリの上に浮かぶターミナルウィンドウ</string>

    <!-- ===================== Compact extra-keys panel =====================
         The panel folds its rows when the window is in landscape. The fold is a derived layout, so
         these strings describe the behaviour and the order of the keys inside a folded row; the
         stored layout is never rewritten. The preview title labels the read-only preview of the
         folded panel under the editable grid in the extra-keys editor. -->
    <string name="extra_keys_compact_landscape_title">横向きのコンパクトパネル</string>
    <string name="extra_keys_compact_landscape_summary">横向きでは2〜3行のボタンが1行に、4行が2行に折りたたまれます。</string>
    <string name="extra_keys_compact_mode_title">折りたたみ順</string>
    <string name="extra_keys_compact_mode_rows">行順</string>
    <string name="extra_keys_compact_mode_columns">列順</string>
</resources>
