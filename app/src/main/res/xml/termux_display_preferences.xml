<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/display_preferences_title">

    <PreferenceCategory
        app:title="@string/appearance_category_title"
        app:iconSpaceReserved="false">

        <ListPreference
            app:key="theme_mode"
            app:title="@string/theme_mode_title"
            app:useSimpleSummaryProvider="true"
            app:entries="@array/theme_mode_entries"
            app:entryValues="@array/theme_mode_values"
            app:defaultValue="system"
            app:iconSpaceReserved="false" />

        <Preference
            app:key="color_scheme_light"
            app:title="@string/color_scheme_light_title"
            app:summary="@string/color_scheme_light_summary"
            app:iconSpaceReserved="false" />

        <Preference
            app:key="color_scheme_dark"
            app:title="@string/color_scheme_dark_title"
            app:summary="@string/color_scheme_dark_summary"
            app:iconSpaceReserved="false" />

        <!-- Terminal font size, in pixels — the very same preference the pinch-to-zoom gesture
             writes, so both entry points stay in sync by construction. The bounds and the step are
             (re)applied from code in DisplayPreferencesFragment, because the lower bound is derived
             from the display density (4dp) and cannot be written as a literal here; app:min /
             android:max only need to form a valid range so the preference inflates. -->
        <SeekBarPreference
            app:key="terminal-font-size"
            app:title="@string/terminal_font_size_title"
            app:min="1"
            android:max="256"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />

        <SeekBarPreference
            app:key="button_bg_inactive_alpha"
            app:title="@string/termux_button_bg_inactive_alpha_title"
            app:defaultValue="5"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />

        <SeekBarPreference
            app:key="button_bg_active_alpha"
            app:title="@string/termux_button_bg_active_alpha_title"
            app:defaultValue="12"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />

        <!-- 0% = wallpaper disabled (the default, and today's behaviour); 40% = maximum. -->
        <SeekBarPreference
            app:key="terminal-background-transparency"
            app:title="@string/terminal_background_transparency_title"
            app:min="0"
            android:max="40"
            app:defaultValue="0"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />

        <!-- Android 12+ system blur (FLAG_BLUR_BEHIND) of the wallpaper above. The blur is
             controlled by this radius slider alone: a radius of 0 disables the blur (sharp
             wallpaper) and any positive value enables it. Disabled by the fragment below API 31
             and whenever the background transparency is 0%. -->
        <SeekBarPreference
            app:key="terminal-background-blur-radius"
            app:title="@string/terminal_background_blur_radius_title"
            app:summary="@string/terminal_background_blur_radius_summary"
            app:min="0"
            android:max="90"
            app:defaultValue="0"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory app:key="tabs" app:title="@string/tabs_category_title" app:iconSpaceReserved="false">
        <ListPreference
            app:key="tab_panel_position"
            app:title="@string/termux_tab_panel_position_title"
            app:useSimpleSummaryProvider="true"
            app:entries="@array/tab_panel_position_entries"
            app:entryValues="@array/tab_panel_position_values"
            app:defaultValue="top"
            app:iconSpaceReserved="false" />

        <ListPreference
            app:key="tab_height_mode"
            app:title="@string/termux_tab_height_mode_title"
            app:useSimpleSummaryProvider="true"
            app:entries="@array/tab_height_mode_entries"
            app:entryValues="@array/tab_height_mode_values"
            app:defaultValue="single"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            app:key="swipe_rightmost_new_tab"
            app:title="@string/swipe_rightmost_new_tab_title"
            app:defaultValue="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            app:key="restore_sessions"
            app:title="@string/restore_tabs_title"
            app:defaultValue="false"
            app:iconSpaceReserved="false" />

        <SeekBarPreference
            app:key="directory_history_max"
            app:title="@string/directory_history_max_title"
            app:defaultValue="20"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/terminal_category_title"
        app:iconSpaceReserved="false">

        <Preference
            app:key="terminal-transcript-rows"
            app:title="@string/terminal_transcript_rows_title"
            app:summary="@string/terminal_transcript_rows_summary"
            app:iconSpaceReserved="false" />

        <ListPreference
            app:key="terminal-cursor-style"
            app:defaultValue="block"
            android:persistent="false"
            app:title="@string/terminal_cursor_style_title"
            app:useSimpleSummaryProvider="true"
            app:entries="@array/terminal_cursor_style_entries"
            app:entryValues="@array/terminal_cursor_style_values"
            app:iconSpaceReserved="false" />


        <SwitchPreferenceCompat
            app:key="scroll-on-new-output"
            app:title="@string/scroll_on_new_output_title"
            android:persistent="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            app:key="terminal-cursor-blink-enabled"
            app:title="@string/terminal_cursor_blink_enabled_title"
            app:defaultValue="false"
            app:iconSpaceReserved="false" />

        <Preference
            app:key="terminal-cursor-blink-rate"
            app:title="@string/terminal_cursor_blink_rate_title"
            app:summary="@string/terminal_cursor_blink_rate_summary"
            app:iconSpaceReserved="false" />

        <SeekBarPreference
            app:key="terminal-margin-left"
            app:title="@string/terminal_margin_left_title"
            app:min="0"
            android:max="20"
            app:defaultValue="2"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />

        <SeekBarPreference
            app:key="terminal-margin-top"
            app:title="@string/terminal_margin_top_title"
            app:min="0"
            android:max="20"
            app:defaultValue="0"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />

        <SeekBarPreference
            app:key="terminal-margin-right"
            app:title="@string/terminal_margin_right_title"
            app:min="0"
            android:max="20"
            app:defaultValue="2"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />

        <SeekBarPreference
            app:key="terminal-margin-bottom"
            app:title="@string/terminal_margin_bottom_title"
            app:min="0"
            android:max="20"
            app:defaultValue="0"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="window"
        app:title="@string/window_category_title"
        app:iconSpaceReserved="false">

        <ListPreference
            app:key="screen_orientation"
            app:title="@string/screen_orientation_title"
            app:useSimpleSummaryProvider="true"
            app:entries="@array/screen_orientation_entries"
            app:entryValues="@array/screen_orientation_values"
            app:defaultValue="sensor"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            app:key="fullscreen"
            app:title="@string/fullscreen_title"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>
</PreferenceScreen>
