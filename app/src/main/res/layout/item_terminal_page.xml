<?xml version="1.0" encoding="utf-8"?>
<!-- A single terminal page inside the horizontal session pager (ViewPager2).
     Each page hosts its own TerminalView bound to one TerminalSession, so a
     horizontal swipe reveals the neighbouring session mid-drag (smooth paging).

     The trailing "new tab" placeholder reuses this exact layout: when it is the
     placeholder (no session bound yet) the terminal_view_page is left unbound and the
     terminal_placeholder_hint_container overlay is shown; on commit the overlay is hidden
     and the session is attached to the SAME TerminalView — an in-place rebind, so the
     transition reads identically to a normal tab-to-tab swipe. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <com.termux.view.TerminalView
        android:id="@+id/terminal_view_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:defaultFocusHighlightEnabled="false"
        android:focusableInTouchMode="true"
        android:scrollbarThumbVertical="@drawable/terminal_scroll_shape"
        android:scrollbars="vertical" />

    <!-- Placeholder overlay, only visible on the trailing placeholder page (hidden by default).
         Holds two independent layers:
           - terminal_directory_picker: the directory list of the right-swipe picker, drawn onto
             the page at coordinates derived from the finger's latched vertical position;
           - terminal_placeholder_hint_content: the "+ new session" block, translated horizontally
             during a drag so it stays centered in the slice of the placeholder page that is
             currently visible (and vertically by DirectoryPickerController so it always sits above
             the list). Its layout_gravity="center" is load-bearing — the horizontal translation is
             expressed relative to the centred position.

         INVISIBLE, never GONE, as the initial state too: the adapter toggles this container on
         every page bind (VISIBLE for the placeholder page, INVISIBLE for a real one), and
         View.setFlags() only calls requestLayout() when the GONE bit changes — so starting from
         GONE would put a full-window layout traversal on the first bind of every page, including
         the placeholder re-arm that lands a frame after a commit, i.e. inside the settle animation
         of the gesture that just finished. Nothing reads this as "not GONE": the only reader
         (TerminalPagerAdapter#fadeOutPlaceholderOverlay) tests `getVisibility() != VISIBLE`, which
         is true for INVISIBLE exactly as it was for GONE. -->
    <FrameLayout
        android:id="@+id/terminal_placeholder_hint_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:forceHasOverlappingRendering="false"
        android:visibility="invisible">

        <!-- INVISIBLE, never GONE: the picker paints nothing unless a gesture installed a list
             (see DirectoryPickerView.onDraw), so hiding it is purely a "do not draw" state — but
             GONE also makes View.setFlags() call requestLayout() (the GONE bit is what triggers it,
             not the visibility as such), i.e. a layout traversal of the whole window on the very
             frame the placeholder is first revealed and again when the gesture ends. INVISIBLE
             keeps the view out of the draw pass without ever touching that bit. -->
        <com.termux.app.terminal.DirectoryPickerView
            android:id="@+id/terminal_directory_picker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible" />

        <LinearLayout
            android:id="@+id/terminal_placeholder_hint_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/terminal_placeholder_hint_plus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_add"
                android:tint="?attr/colorOnSurface"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/terminal_placeholder_hint_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/new_tab_placeholder_hint"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
